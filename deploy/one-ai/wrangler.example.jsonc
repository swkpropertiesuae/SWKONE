{
  "name": "swk-one-ai-gateway",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "swk-one-ai", "database_id": "REPLACE_WITH_D1_ID" }],
  "routes": [{ "pattern": "one-ai-gateway.swk.properties", "custom_domain": true }],
  "vars": { "CF_DAILY_NEURONS": "6500" }
}
